# ─── Production / VPS — kopyala: cp .env.example .env && deploy/setup.sh ───

NODE_ENV=production

# PostgreSQL (docker-compose ile aynı şifre)
POSTGRES_USER=pintio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=pintio
DATABASE_URL=postgresql://pintio:CHANGE_ME_STRONG_PASSWORD@localhost:5432/pintio

# Redis
REDIS_URL=redis://localhost:6379

# JWT — openssl rand -hex 32 ile üret
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_64_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# OAuth (store yayını öncesi)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# API
API_PORT=3000
API_URL=https://api.pintio.app

# Scraper
SCRAPER_WORKERS=6
SEED_PER_STORE=500
FLASH_SEED_LIMIT=10000
P1_CHECK_INTERVAL_SEC=180
P0_CHECK_INTERVAL_SEC=90

# Push (opsiyonel — Expo Push kullanılıyorsa boş kalabilir)
FCM_SERVER_KEY=
