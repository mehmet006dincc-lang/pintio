[Unit]
Description=Pintio price worker
After=docker.service network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/apps/pintio/scraper
EnvironmentFile=/home/deploy/apps/pintio/.env
ExecStart=/home/deploy/apps/pintio/scraper/.venv/bin/python worker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
